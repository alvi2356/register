xst -intstyle ise -ifn "/home/ise/Desktop/Register_8bit_Xilinx_Project/register_8bit.xst" -ofn "/home/ise/Desktop/Register_8bit_Xilinx_Project/register_8bit.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx4-tqg144-3 register_8bit.ngc register_8bit.ngd  
map -intstyle ise -p xc6slx4-tqg144-3 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o register_8bit_map.ncd register_8bit.ngd register_8bit.pcf 
netgen -intstyle ise -ar Structure -tm register_8bit -w -dir netgen/synthesis -ofmt vhdl -sim register_8bit.ngc register_8bit_synthesis.vhd 
